{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint:check)",
      "Bash(npm run format:check)",
      "Bash(npm test *)",
      "Bash(npm run test *)",
      "Bash(npm run build:*)",
      "Bash(npx eslint *)",
      "Bash(npx jest *)",
      "Bash(npm run prisma:generate:*)"
    ],
    "deny": [
      "Bash(yarn *)",
      "Bash(pnpm *)",
      "Bash(pnpx *)",
      "Bash(bun *)",
      "Bash(bunx *)",
      "Bash(npx -y *)",
      "Bash(npx --yes *)",

      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push origin master *)",
      "Bash(git push origin main *)",
      "Bash(git push origin develop *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f *)",
      "Bash(git clean -fd *)",
      "Bash(git clean -fdx *)",
      "Bash(git clean -xdf *)",
      "Bash(git checkout master)",
      "Bash(git checkout main)",
      "Bash(git checkout develop)",
      "Bash(git switch master)",
      "Bash(git switch main)",
      "Bash(git switch develop)",

      "Bash(npx prisma db push *)",
      "Bash(npx prisma migrate reset *)",
      "Bash(npx prisma db execute *)",
      "Bash(prisma db push *)",
      "Bash(prisma migrate reset *)",
      "Bash(prisma db execute *)",
      "Bash(dropdb *)",

      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.docker)",
      "Read(./.env.*.local)",
      "Read(./.env.production*)",
      "Read(./apps/*/.env)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.kubeconfig)",

      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.docker)",
      "Edit(./package-lock.json)",
      "Edit(./apps/*/src/generated/**)",
      "Edit(./libs/grpc/generated/**)",
      "Edit(./apps/*/prisma/migrations/migration_lock.toml)"
    ],
    "ask": [
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Bash(npx prisma migrate dev *)",
      "Bash(npx prisma migrate deploy *)",
      "Bash(npx prisma migrate resolve *)",
      "Bash(npm run prisma:migrate*)",
      "Bash(npm run prisma:deploy*)",
      "Bash(npm run prisma:seed*)",
      "Bash(kubectl delete *)",
      "Bash(kubectl apply *)",
      "Bash(helm *)",
      "Bash(docker compose down *)",

      "Edit(./apps/*/prisma/schema.prisma)",
      "Edit(./libs/grpc/proto/**)",
      "Edit(./k8s/**)",
      "Edit(./.github/workflows/**)",
      "Edit(./infrastructure/**)",
      "Edit(./seed_data/**)",
      "Edit(./scripts/deploy.sh)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.js\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-edit.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-verify.js\"",
            "timeout": 300,
            "statusMessage": "stop-verify: ESLint + Jest trên file đã sửa..."
          }
        ]
      }
    ]
  }
}
